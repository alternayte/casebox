{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casebox-docs.pages.dev/schema/casebox.schema.json",
  "title": "casebox.yml",
  "description": "A repository's Casebox settings in .casebox/casebox.yml. Reviewed like code. Privacy settings live on the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "The file format version."
    },
    "server": {
      "type": "string",
      "format": "uri",
      "description": "The Casebox server, such as https://casebox.example.com."
    },
    "workspace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "The workspace this repository belongs to. A shared harness repository has none."
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
      },
      "description": "The workspace's repositories, such as github.com/acme/payments-api."
    },
    "work_items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jira": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "url",
            "projects"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The Jira Data Center URL."
            },
            "projects": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "minItems": 1
            }
          }
        },
        "github_issues": {
          "type": "boolean",
          "description": "Track GitHub Issues as work items."
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The harness files Casebox reads and proposes changes to, matched against whole repo-relative paths. Default: AGENTS.md, CLAUDE.md, .cursor/rules/**, .claude/skills/**, .agents/skills/**, .mcp.json, .cursor/mcp.json."
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redact": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra regular expressions whose matches are redacted before anything leaves the machine."
        }
      }
    }
  }
}

<Project>
  <!-- The Deedbox family ships in lockstep; every package pins the same version. -->
  <PropertyGroup>
    <DeedboxVersion>0.4.0</DeedboxVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Deedbox" Version="$(DeedboxVersion)" />
    <PackageVersion Include="Deedbox.Postgres" Version="$(DeedboxVersion)" />
    <PackageVersion Include="Deedbox.QueueBox" Version="$(DeedboxVersion)" />
    <PackageVersion Include="QueueBox.Inbox" Version="0.3.1" />
    <PackageVersion Include="Deedbox.Keys.AzureKeyVault" Version="$(DeedboxVersion)" />
    <PackageVersion Include="Npgsql" Version="10.0.2" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <!-- Tests only. -->
  <ItemGroup>
    <PackageVersion Include="Deedbox.Testing" Version="$(DeedboxVersion)" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
</Project>
